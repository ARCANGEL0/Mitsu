Screen {
    layout: vertical;
    background: #0b0a0b;
    color: #e7e2dc;
}

#boot-screen {
    height: 100%;
    content-align: center middle;
    color: #e58b6b;
    background: #0b0a0b;
}

#wizard-shell {
    width: 100%;
    height: 100%;
    padding: 0;
    background: #0b0a0b;
}

#wizard-masthead {
    position: relative;
    width: 100%;
    height: 19;
}

#menu-masthead {
    position: relative;
    width: 100%;
    height: 19;
}

#wizard-mascot,
#menu-companion {
    width: 16;
    height: 8;
    content-align: center middle;
    background: transparent;
}

#menu-companion {
    position: absolute;
    offset: 0 0;
    width: 0;
    height: 0;
}

.mascot-flourish {
    width: 100%;
    height: 1;
    color: #e58b6b;
    text-align: center;
}

#menu-moon {
    width: 100%;
    height: 9;
    background: transparent;
}

#menu-landscape {
    width: 100%;
    height: 10;
}

#menu-city {
    position: absolute;
    offset: 0 0;
    width: 100%;
    height: 10;
}

#wizard-moon {
    width: 100%;
    height: 9;
    background: transparent;
    color: #f5d36e;
}

#wizard-landscape {
    width: 100%;
    height: 10;
}

#wizard-city {
    position: absolute;
    offset: 0 0;
    width: 100%;
    height: 10;
}

#wizard-mascot {
    position: absolute;
    offset: 0 0;
    width: 0;
    height: 0;
}

#wizard-pages {
    height: 1fr;
    width: 100%;
    align: center middle;
    padding: 0 2;
}

.wizard-page {
    width: 100%;
    max-width: 88;
    height: auto;
    padding: 1 2;
    align-horizontal: center;
    background: transparent;
}

#wizard-page-search {
    max-width: 96;
}

.search-engine-panel {
    width: 100%;
    height: auto;
    padding: 0;
    background: transparent;
}

#wizard-page-search #search-engine-list {
    max-height: 12;
    border: none;
    background: transparent;
}

#wizard-page-search #search-engine-detail {
    min-height: 1;
    height: auto;
    margin-bottom: 1;
}

#wizard-page-search #search-engine-status {
    height: auto;
    min-height: 1;
}

#search-engine-status.search-engine-warning {
    color: #ef7180;
    text-style: bold;
}

#search-engine-editor-title.search-engine-warning {
    color: #ef7180;
}

.wizard-title {
    width: 100%;
    height: 1;
    margin-bottom: 2;
    color: #e58b6b;
    text-style: bold;
    text-align: center;
}

.wizard-copy {
    width: 100%;
    height: auto;
    margin-bottom: 2;
    color: #d0cbc5;
    text-align: center;
}

#wizard-page-welcome {
    max-width: 78;
    padding: 1 4;
    border: round #493c3a;
}

#welcome-eyebrow {
    width: 100%;
    height: 1;
    margin-bottom: 0;
    color: #9d8b82;
    text-style: bold;
    text-align: center;
}

#wizard-page-welcome .wizard-title {
    margin-bottom: 1;
}

#wizard-page-welcome .wizard-copy {
    margin-bottom: 1;
}

#welcome-prompt {
    width: 100%;
    height: 2;
    margin-top: 1;
    border-top: solid #403638;
    color: #55e5e8;
    text-style: bold;
    text-align: center;
}

.wizard-note {
    width: 100%;
    height: auto;
    margin-top: 1;
    color: #948c86;
    text-align: center;
}

#wizard-status {
    width: 100%;
    height: auto;
    min-height: 1;
    color: #ef9b82;
    text-align: center;
}

.field-label {
    height: 1;
    margin-top: 1;
    color: #c7b9b1;
    text-align: center;
}

OptionList {
    height: auto;
    max-height: 15;
    border: none;
    padding: 0 1;
    background: transparent;
    color: #d0cbc5;
}

OptionList:focus {
    border: none;
    background: transparent;
}

OptionList > .option-list--option-highlighted,
OptionList:focus > .option-list--option-highlighted {
    color: #e58b6b;
    background: transparent;
    text-style: bold underline;
}

#provider-list {
    width: 62;
    max-height: 11;
}

#protocol-list {
    width: 62;
    max-height: 3;
}

#model-list {
    width: 72;
    max-height: 15;
}

#custom-base-url,
#provider-api-key,
#cloudflare-account-id,
#custom-model-name {
    width: 68;
    height: 3;
    margin: 1 0;
    padding: 0 1;
    border: none;
    border-bottom: solid #514642;
    background: transparent;
}

#custom-base-url:focus,
#provider-api-key:focus,
#cloudflare-account-id:focus,
#custom-model-name:focus {
    border: none;
    border-bottom: solid #e58b6b;
    background: transparent;
}

#wizard-page-models .wizard-copy {
    margin-bottom: 1;
}

#theme-layout {
    width: 100%;
    height: auto;
    align: center middle;
}

#theme-list {
    width: 36;
    max-height: 8;
}

#theme-preview {
    width: 44;
    height: 8;
    padding: 0 2;
    content-align: left middle;
    border-left: solid #403633;
    color: #e58b6b;
    text-align: left;
}

#companion-list {
    width: 56;
    height: auto;
    max-height: 12;
    scrollbar-size-vertical: 1;
}

#wizard-controls {
    width: 100%;
    height: 1;
    margin-top: 1;
    color: #8c817c;
    text-align: center;
}

#wizard-credit {
    height: 1;
    width: 100%;
    color: #625d59;
    text-style: dim;
    text-align: center;
}

#menu-shell {
    width: 100%;
    height: 100%;
    padding: 0;
    background: #0b0a0b;
}

#menu-dashboard {
    width: 100%;
    height: 1fr;
    border-top: solid #403633;
}

#menu-left-panel {
    width: 34%;
    min-width: 28;
    max-width: 44;
    height: 100%;
    padding: 2 3 1 2;
    border-right: solid #403633;
}

.menu-section-title {
    height: 1;
    margin-bottom: 1;
    color: #e58b6b;
    text-style: bold;
}

#menu-left-rule {
    height: 1;
    margin-bottom: 1;
    color: #514642;
}

#menu-left-list {
    width: 100%;
    height: 5;
    color: #d0cbc5;
}

#menu-left-spacer {
    height: 1fr;
}

#menu-runtime-info {
    height: auto;
    margin-top: 0;
    color: #aaa19a;
}

#menu-right-panel {
    width: 1fr;
    height: 100%;
    min-width: 30;
    padding: 2 4 1 4;
    border: round #403633;
}

#menu-right-title {
    height: 1;
    margin-bottom: 1;
    color: #e58b6b;
    text-style: bold;
}

#menu-model-search {
    display: none;
    width: 100%;
    height: 3;
    margin-bottom: 1;
    padding: 0 1;
    border: round #315459;
    background: #0b1114;
    color: #e7e2dc;
}

#menu-model-search:focus {
    border: round #55e5e8;
}

#menu-right-list {
    width: 100%;
    height: 1fr;
    min-height: 1;
    max-height: 18;
    color: #d0cbc5;
}

#menu-right-detail {
    width: 100%;
    height: auto;
    margin-top: 2;
    color: #aaa19a;
}

#menu-mcp-editor {
    display: none;
    width: 100%;
    height: 1fr;
    min-height: 8;
    margin-top: 1;
    border: round #315459;
    background: #0b1114;
    color: #d8f3f0;
}

#menu-mcp-editor:focus {
    border: round #55e5e8;
}

#menu-custom-tool-form {
    display: none;
    width: 100%;
    height: auto;
    margin-top: 1;
}

#menu-custom-tool-form-title {
    height: 1;
    margin-bottom: 1;
    color: #e58b6b;
    text-style: bold;
}

#menu-custom-tool-step {
    width: 100%;
    height: auto;
    margin-bottom: 1;
    color: #aaa19a;
}

#menu-custom-tool-input {
    width: 100%;
    height: 3;
    border: round #315459;
    background: #0b1114;
    color: #d8f3f0;
}

#menu-custom-tool-input:focus {
    border: round #55e5e8;
}

#menu-custom-tool-nav-hint {
    height: 1;
    margin-top: 1;
    color: #817a75;
}

#menu-secret-input,
#menu-text-input {
    display: none;
    width: 100%;
    height: 3;
    margin-top: 1;
    padding: 0 1;
    border: none;
    border-bottom: solid #514642;
    background: transparent;
    color: #e7e2dc;
}

#menu-secret-input:focus,
#menu-text-input:focus {
    border-bottom: solid #55e5e8;
}

#menu-footer {
    height: 2;
    width: 100%;
    padding: 1 1 0 1;
    color: #8c817c;
    text-align: center;
}

#session-topbar {
    width: 100%;
    height: 2;
    padding: 0 2;
    border-bottom: solid #315459;
    background: #0d1215;
}

#session-center {
    width: 100%;
    height: 1fr;
}

#session-left {
    width: 30;
    height: 100%;
    padding: 1;
    border-right: solid #315459;
    background: #0d1114;
}

.session-section-title {
    height: 2;
    padding-top: 1;
    color: #e58b6b;
    text-style: bold;
}

#session-companion {
    width: 100%;
    height: 9;
    content-align: center middle;
    background: transparent;
}

#companion-status {
    height: 1;
    color: #91bd9b;
    text-style: bold;
    text-align: center;
}

.session-label {
    height: 2;
    padding-top: 1;
    color: #c7b9b1;
}

#project-path {
    height: auto;
    color: #aaa6a0;
}

#aggressive-level {
    height: auto;
    margin-bottom: 1;
}

#search-status {
    display: none;
    height: auto;
    max-height: 5;
    margin: 0 0 1 1;
    padding-left: 1;
    border-left: tall $primary;
    color: $foreground;
}

#search-label {
    display: none;
}

#session-transcript-panel {
    width: 1fr;
    height: 100%;
    min-width: 24;
}

#session-heading {
    height: 3;
    padding: 0 2;
    border-bottom: solid #315459;
    background: #101417;
}

#session-title {
    height: 1;
    color: #e58b6b;
    text-style: bold;
}

#session-subtitle {
    height: 1;
    color: #928982;
}

#conversation {
    width: 100%;
    height: 1fr;
    padding: 1 2;
    scrollbar-size-vertical: 1;
    scrollbar-color: #315459;
    scrollbar-color-hover: #55e5e8;
    scrollbar-color-active: #55e5e8;
    scrollbar-background: #0b0a0b;
    scrollbar-background-hover: #0b0a0b;
    scrollbar-background-active: #0b0a0b;
}

.system-message,
.assistant-message {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
    padding-left: 1;
    border-left: solid #315459;
    background: #101417;
    color: #c7c1bb;
}

.streaming-message {
    border-left: tall #55e5e8;
    background: #121b1e;
}

.user-message {
    width: 100%;
    height: auto;
    margin: 1 0;
    padding-left: 1;
    border-left: solid #bd8eb7;
    background: #171319;
    color: #f0ebe6;
}

.tool-message {
    width: 100%;
    height: auto;
    margin: 1 0 0 1;
    padding-left: 1;
    border-left: solid #55e5e8;
    color: #55e5e8;
}

.tool-result-message {
    width: 100%;
    height: auto;
    margin: 0 0 1 2;
    padding-left: 1;
    border-left: solid #315459;
    color: #aaa6a0;
}

.tool-result-message:hover {
    border-left: solid #55e5e8;
    color: #d3cec7;
}

.tool-result-message:focus {
    border-left: tall #55e5e8;
}

.success-message {
    width: 100%;
    height: auto;
    margin-bottom: 1;
    color: #91bd9b;
}

.error-message {
    width: 100%;
    height: auto;
    margin-bottom: 1;
    color: #e58b6b;
}

#session-right {
    width: 33;
    height: 100%;
    padding: 1;
    border-left: solid #315459;
    background: #0d1114;
    scrollbar-size-vertical: 1;
    scrollbar-color: #315459;
    scrollbar-color-hover: #55e5e8;
    scrollbar-color-active: #55e5e8;
    scrollbar-background: #0b0a0b;
    scrollbar-background-hover: #0b0a0b;
    scrollbar-background-active: #0b0a0b;
}

#intel-summary,
#target-summary,
#target-list,
#observations-summary,
#findings-summary,
#exploits-summary,
#ips-summary,
#harvested-summary,
#activity-summary,
#aggressive-level {
    height: auto;
    color: #aaa6a0;
}

#target-list {
    margin-top: 1;
}

#findings-summary,
#exploits-summary,
#ips-summary,
#harvested-summary,
#activity-summary,
#intel-summary {
    margin-bottom: 1;
}

#observations-scroll {
    width: 100%;
    height: 10;
    max-height: 14;
    margin-bottom: 1;
    padding-left: 1;
    border-left: solid #315459;
    background: #0d1114;
    scrollbar-size-vertical: 1;
    scrollbar-color: #315459;
    scrollbar-color-hover: #55e5e8;
    scrollbar-color-active: #55e5e8;
}

#observations-summary {
    height: auto;
    color: #aaa6a0;
}

#composer {
    width: 100%;
    height: auto;
    min-height: 6;
    max-height: 17;
    padding: 0 2 0 2;
    border-top: solid #315459;
    background: #101619;
}

#thinking-status {
    display: none;
    width: 100%;
    height: 1;
    margin-left: 2;
    padding-left: 1;
    border-left: tall #55e5e8;
    background: #132023;
}

#queue-status {
    display: none;
    width: 100%;
    height: auto;
    max-height: 4;
    margin-left: 2;
    padding-left: 1;
    border-left: tall $primary;
    background: $surface;
}

.theme-moss #thinking-status {
    border-left: tall #91bd9b;
    background: #17241b;
}

.theme-lilac #thinking-status {
    border-left: tall #b8a4d7;
    background: #201a29;
}

.theme-ocean #thinking-status {
    border-left: tall #67c9e4;
    background: #142329;
}

.theme-rose #thinking-status {
    border-left: tall #e996b4;
    background: #281a21;
}

.theme-gold #thinking-status {
    border-left: tall #e9c46a;
    background: #282316;
}

.theme-blue #thinking-status {
    border-left: tall #8baceb;
    background: #192033;
}

#slash-suggestions {
    display: none;
    width: 100%;
    height: auto;
    max-height: 9;
    margin: 0 0 0 2;
    padding: 0 1;
    border-left: tall #55e5e8;
    background: #101d20;
}

#command-panel {
    display: none;
    width: 100%;
    height: auto;
    max-height: 12;
    padding: 0 1;
    border-left: solid $primary;
    background: $surface;
}

#command-panel.level-panel {
    max-height: 18;
}

#command-panel.level-panel #command-panel-scroll {
    max-height: 5;
}

#command-panel.level-panel #command-panel-options {
    max-height: 7;
}

#command-panel-title {
    height: 1;
    color: $primary;
    text-style: bold;
}

#command-panel-scroll {
    width: 100%;
    height: auto;
    min-height: 2;
    max-height: 7;
    margin-top: 1;
    padding: 0 1;
    background: $surface;
}

#command-panel-content {
    width: 100%;
    height: auto;
    color: $foreground;
}

#command-panel-options {
    width: 100%;
    height: auto;
    max-height: 5;
    margin-top: 1;
    border: solid $secondary;
    background: $surface;
}

#command-panel-options > .option-list--option-highlighted,
#command-panel-options:focus > .option-list--option-highlighted {
    color: $primary;
    background: transparent;
    text-style: bold;
}

#command-panel.level-panel #command-panel-options > .option-list--option-highlighted,
#command-panel.level-panel #command-panel-options:focus > .option-list--option-highlighted {
    color: $background;
    background: $primary;
    text-style: bold;
}

#command-panel-input {
    display: none;
    width: 100%;
    margin-top: 1;
}

#command-panel-hint {
    height: 1;
    margin-top: 1;
    color: $text-muted;
    text-align: center;
}

#prompt-line {
    width: 100%;
    height: 4;
    padding-right: 1;
    background: #11191c;
}

#prompt-symbol {
    width: 2;
    content-align: center middle;
    background: #173034;
    color: #55e5e8;
    text-style: bold;
}

#prompt-input {
    width: 1fr;
    height: 4;
    padding: 0 1;
    border: solid #315459;
    background: #121b1e;
    color: #e7e2dc;
}

#prompt-input:focus {
    border: solid #55e5e8;
    background: #162428;
}

.theme-moss #prompt-symbol {
    color: #91bd9b;
    background: #17241b;
}

.theme-moss #prompt-input:focus {
    border: solid #91bd9b;
    background: #17231b;
}

.theme-moss #slash-suggestions {
    border-left: tall #91bd9b;
    background: #111b15;
}

.theme-lilac #prompt-symbol {
    color: #b8a4d7;
    background: #201a29;
}

.theme-lilac #prompt-input:focus {
    border: solid #b8a4d7;
    background: #201a29;
}

.theme-lilac #slash-suggestions {
    border-left: tall #b8a4d7;
    background: #19151f;
}

.theme-ocean #prompt-symbol {
    color: #67c9e4;
    background: #142329;
}

.theme-ocean #prompt-input:focus {
    border: solid #67c9e4;
    background: #14242b;
}

.theme-ocean #slash-suggestions {
    border-left: tall #67c9e4;
    background: #101b20;
}

.theme-rose #prompt-symbol {
    color: #e996b4;
    background: #281a21;
}

.theme-rose #prompt-input:focus {
    border: solid #e996b4;
    background: #291b23;
}

.theme-rose #slash-suggestions {
    border-left: tall #e996b4;
    background: #1d1519;
}

.theme-gold #prompt-symbol {
    color: #e9c46a;
    background: #282316;
}

.theme-gold #prompt-input:focus {
    border: solid #e9c46a;
    background: #282316;
}

.theme-gold #slash-suggestions {
    border-left: tall #e9c46a;
    background: #1e1b13;
}

.theme-blue #prompt-symbol {
    color: #8baceb;
    background: #192033;
}

.theme-blue #prompt-input:focus {
    border: solid #8baceb;
    background: #192033;
}

.theme-blue #slash-suggestions {
    border-left: tall #8baceb;
    background: #151a27;
}

ProviderDialog,
SessionRenameDialog,
MCPConfigDialog,
AskUserDialog,
ConversationSearchDialog,
DeleteSessionDialog,
SessionThemeDialog {
    align: center middle;
    background: #000000 48%;
}

ToolApprovalDialog {
    align: center bottom;
    background: transparent;
}

CompanionDialog {
    align: center middle;
    background: #000000 38%;
}

SearchEngineDialog {
    align: center middle;
    background: #000000 38%;
}

DeleteSessionDialog {
    background: #000000 38%;
}

#provider-dialog,
#general-config-dialog,
#search-engine-dialog,
#rename-dialog,
#mcp-dialog,
#ask-user-dialog,
#operator-dialog,
#sudo-password-dialog,
#tool-approval-dialog,
#conversation-search-dialog,
#delete-session-dialog,
#pet-dialog {
    width: 76;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    border: round #55e5e8;
    background: #111115;
}

#pet-dialog {
    width: 88;
    max-width: 92%;
    padding: 1 2;
}

#pet-dialog-title {
    height: 1;
    margin-bottom: 1;
    color: #55e5e8;
    text-style: bold;
    text-align: center;
}

#pet-dialog-description {
    height: auto;
    margin-bottom: 1;
    color: #aaa6a0;
    text-align: center;
}

#pet-dialog-options {
    width: 1fr;
    height: auto;
    max-height: 12;
    border: solid #403633;
    background: #111115;
}

#pet-dialog-layout {
    width: 100%;
    height: auto;
    min-height: 16;
    margin-bottom: 1;
}

#pet-dialog-preview-panel {
    width: 28;
    height: 16;
    align: center middle;
    padding: 0 1;
}

#pet-dialog-preview {
    width: 100%;
    height: 12;
    content-align: center middle;
}

#pet-dialog-hint {
    height: 1;
    margin-top: 1;
    color: #8c817c;
    text-align: center;
}

#provider-dialog-title,
#general-config-title,
#rename-dialog-title {
    height: 1;
    margin-bottom: 1;
    color: #55e5e8;
    text-style: bold;
    text-align: center;
}

#mcp-dialog-title {
    height: 1;
    margin-bottom: 1;
    color: #55e5e8;
    text-style: bold;
    text-align: center;
}

#ask-user-title,
#operator-dialog-title,
#sudo-password-title,
#tool-approval-title,
#conversation-search-title,
#delete-session-title {
    height: 1;
    margin-bottom: 1;
    color: #55e5e8;
    text-style: bold;
    text-align: center;
}

#operator-dialog,
#sudo-password-dialog {
    width: 76;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    border: round #55e5e8;
    background: #111115;
}

#operator-dialog-question,
#sudo-password-message {
    height: auto;
    margin: 1 0;
    color: #b8b2ab;
}

#operator-dialog-options {
    height: auto;
    max-height: 14;
    margin: 1 0;
}

#operator-dialog-input,
#sudo-password-input {
    margin: 1 0;
}

#operator-dialog-actions,
#sudo-password-actions {
    height: auto;
    align-horizontal: right;
}

#operator-dialog-hint,
#sudo-password-hint {
    height: auto;
    margin-top: 1;
    color: #8f9999;
    text-align: center;
}

#delete-session-title {
    color: #f07882;
}

#delete-session-actions {
    width: 100%;
    height: 3;
    margin: 1 0;
    align: center middle;
}

#delete-session-cancel,
#delete-session-confirm {
    width: 12;
    height: 3;
    margin: 0 1;
}

#delete-session-cancel {
    color: #55e5e8;
    border: tall #315459;
    background: #101417;
}

#delete-session-cancel:focus {
    border: tall #55e5e8;
    background: #171319;
}

#delete-session-confirm {
    color: #f07882;
    border: tall #6b333c;
    background: #111115;
}

#delete-session-confirm:focus {
    color: #0b0a0b;
    border: tall #f07882;
    background: #f07882;
    text-style: bold;
}

#ask-user-question,
#tool-approval-name,
#delete-session-message {
    width: 100%;
    height: auto;
    margin-bottom: 1;
    color: #e7e2dc;
}

#ask-user-choices,
#tool-approval-options {
    width: 100%;
    height: auto;
    max-height: 12;
    margin-bottom: 1;
    border: round #403633;
    background: #111115;
}

#ask-user-choices > .option-list--option-highlighted,
#ask-user-choices:focus > .option-list--option-highlighted,
#tool-approval-options > .option-list--option-highlighted,
#tool-approval-options:focus > .option-list--option-highlighted {
    color: #55e5e8;
    background: transparent;
    text-style: bold underline;
}

#tool-approval-detail {
    width: 100%;
    height: auto;
    max-height: 6;
    overflow-y: auto;
    margin-bottom: 1;
    padding: 0 1;
    border: round #403633;
    background: #0b0a0b;
    color: #e7e2dc;
}

#tool-approval-dialog {
    width: 96;
    max-width: 94%;
    height: auto;
    max-height: 70%;
    margin-bottom: 3;
    padding: 1 1;
    border: round #55e5e8;
    background: #111115;
}

#tool-approval-options {
    max-height: 5;
    margin-bottom: 1;
}

#ask-user-input {
    width: 100%;
    height: 3;
    margin-bottom: 1;
    padding: 0 1;
    border: round #514642;
    background: #0b0a0b;
    color: #e7e2dc;
}

#ask-user-input:focus {
    border: round #55e5e8;
}

#ask-user-hint,
#tool-approval-hint,
#conversation-search-hint,
#delete-session-hint {
    height: 1;
    color: #8c817c;
    text-align: center;
}

#provider-dialog-detail,
#general-config-description,
#general-config-detail,
#search-engine-detail,
#search-engine-editor-detail,
#rename-dialog-detail {
    width: 100%;
    height: auto;
    min-height: 2;
    color: #c7c1bb;
    text-align: center;
}

#mcp-dialog-detail {
    width: 100%;
    height: 2;
    color: #c7c1bb;
    text-align: center;
}

#provider-dialog-list {
    width: 100%;
    max-height: 16;
    margin-top: 1;
    border: round #403633;
    background: #111115;
}

#general-config-title {
    height: 1;
    margin-bottom: 1;
    color: #55e5e8;
    text-style: bold;
    text-align: center;
}

#general-config-description,
#general-config-detail {
    width: 100%;
    height: auto;
    min-height: 1;
    margin-bottom: 1;
    color: #aaa6a0;
    text-align: center;
}

#general-config-options {
    width: 100%;
    max-height: 18;
    border: round #403633;
    background: #111115;
}

#general-config-options > .option-list--option-highlighted,
#general-config-options:focus > .option-list--option-highlighted {
    color: #55e5e8;
    background: transparent;
    text-style: bold underline;
}

#general-config-hint {
    height: 1;
    margin-top: 1;
    color: #8c817c;
    text-align: center;
}

#search-engine-dialog {
    width: 96;
    max-width: 94%;
    height: auto;
    max-height: 92%;
    padding: 1 2;
    border: round #55e5e8;
    background: #111115;
}

#search-engine-title,
#search-engine-editor-title {
    width: 100%;
    height: 1;
    margin-bottom: 1;
    color: #55e5e8;
    text-style: bold;
    text-align: center;
}

#search-engine-detail,
#search-engine-editor-detail {
    min-height: 1;
    margin-bottom: 1;
    color: #aaa6a0;
    text-align: center;
}

#search-engine-list {
    width: 100%;
    max-height: 13;
    border: round #403633;
    background: #111115;
}

#search-engine-list > .option-list--option-highlighted,
#search-engine-list:focus > .option-list--option-highlighted,
#search-engine-actions > .option-list--option-highlighted,
#search-engine-actions:focus > .option-list--option-highlighted {
    color: #55e5e8;
    background: transparent;
    text-style: bold underline;
}

#search-engine-editor {
    width: 100%;
    height: auto;
}

#docker-password-slot {
    width: 100%;
    height: auto;
}

#docker-password-card {
    width: 56%;
    margin-top: 2;
    padding: 1 2;
    border: round #315459;
    background: #0d1215;
}

#docker-password-card .search-field-label {
    margin-top: 0;
    color: #91a7ad;
}

#search-engine-sudo-password {
    width: 100%;
    height: 3;
    padding: 0 1;
    border: round #315459;
    background: #0b1114;
    color: #e7e2dc;
}

#search-engine-sudo-password:focus {
    border: round #55e5e8;
}

.search-field-label {
    height: 1;
    margin-top: 1;
    color: #aaa6a0;
}

#search-engine-base-url,
#search-engine-api-key,
#search-engine-cx,
#search-engine-port {
    width: 100%;
    height: 3;
    padding: 0 1;
    border: round #514642;
    background: #0b0a0b;
    color: #e7e2dc;
}

#search-engine-base-url:focus,
#search-engine-api-key:focus,
#search-engine-cx:focus,
#search-engine-port:focus {
    border: round #55e5e8;
}

#search-engine-actions {
    width: 100%;
    max-height: 6;
    margin-top: 1;
    border: round #403633;
    background: #111115;
}

#search-engine-status {
    width: 100%;
    min-height: 1;
    height: auto;
    margin-top: 1;
    color: #e9c46a;
    text-align: center;
}

#search-engine-hint {
    height: 1;
    margin-top: 1;
    color: #8c817c;
    text-align: center;
}

#provider-dialog-list > .option-list--option-highlighted,
#provider-dialog-list:focus > .option-list--option-highlighted {
    color: #55e5e8;
    background: transparent;
    text-style: bold underline;
}

#provider-dialog-input,
#rename-dialog-input {
    width: 100%;
    height: 3;
    margin-top: 1;
    padding: 0 1;
    border: round #514642;
    background: #0b0a0b;
    color: #e7e2dc;
}

#provider-dialog-input:focus,
#rename-dialog-input:focus {
    border: round #55e5e8;
}

#mcp-dialog-editor {
    width: 100%;
    height: 12;
    margin-top: 1;
    border: round #514642;
    background: #0b0a0b;
    color: #e7e2dc;
}

#mcp-dialog-editor:focus {
    border: round #55e5e8;
}

#mcp-dialog-hint {
    height: 1;
    margin-top: 1;
    color: #8c817c;
    text-align: center;
}

#provider-dialog-hint {
    height: 1;
    margin-top: 1;
    color: #8c817c;
    text-align: center;
}

#shortcut-hint {
    height: 1;
    padding-left: 2;
    color: #789496;
    margin-top: 0;
}

#session-right {
    scrollbar-size-vertical: 1;
}

#session-right:focus,
#conversation:focus {
    scrollbar-color: #55e5e8;
}

.theme-moss .brand-sparkles,
.theme-moss .mascot-flourish,
.theme-moss .wizard-title,
.theme-moss .menu-section-title,
.theme-moss .session-section-title,
.theme-moss #session-title,
.theme-moss #prompt-symbol {
    color: #91bd9b;
}

.theme-lilac .brand-sparkles,
.theme-lilac .mascot-flourish,
.theme-lilac .wizard-title,
.theme-lilac .menu-section-title,
.theme-lilac .session-section-title,
.theme-lilac #session-title,
.theme-lilac #prompt-symbol {
    color: #b8a4d7;
}

.theme-ocean .brand-sparkles,
.theme-ocean .mascot-flourish,
.theme-ocean .wizard-title,
.theme-ocean .menu-section-title,
.theme-ocean .session-section-title,
.theme-ocean #session-title,
.theme-ocean #prompt-symbol {
    color: #67c9e4;
}

.theme-rose .brand-sparkles,
.theme-rose .mascot-flourish,
.theme-rose .wizard-title,
.theme-rose .menu-section-title,
.theme-rose .session-section-title,
.theme-rose #session-title,
.theme-rose #prompt-symbol {
    color: #e996b4;
}

.theme-gold .brand-sparkles,
.theme-gold .mascot-flourish,
.theme-gold .wizard-title,
.theme-gold .menu-section-title,
.theme-gold .session-section-title,
.theme-gold #session-title,
.theme-gold #prompt-symbol {
    color: #e9c46a;
}

.theme-blue .brand-sparkles,
.theme-blue .mascot-flourish,
.theme-blue .wizard-title,
.theme-blue .menu-section-title,
.theme-blue .session-section-title,
.theme-blue #session-title,
.theme-blue #prompt-symbol {
    color: #8baceb;
}

.theme-moss OptionList:focus > .option-list--option-highlighted {
    color: #91bd9b;
    background: transparent;
    text-style: bold underline;
}

.theme-lilac OptionList:focus > .option-list--option-highlighted {
    color: #b8a4d7;
    background: transparent;
    text-style: bold underline;
}

.theme-ocean OptionList:focus > .option-list--option-highlighted {
    color: #67c9e4;
    background: transparent;
    text-style: bold underline;
}

.theme-rose OptionList:focus > .option-list--option-highlighted {
    color: #e996b4;
    background: transparent;
    text-style: bold underline;
}

.theme-gold OptionList:focus > .option-list--option-highlighted {
    color: #e9c46a;
    background: transparent;
    text-style: bold underline;
}

.theme-blue OptionList:focus > .option-list--option-highlighted {
    color: #8baceb;
    background: transparent;
    text-style: bold underline;
}

/* Palette tokens shared by every screen, dialog, and session element. */
Screen {
    background: $background;
    color: $foreground;
}

ToolApprovalDialog {
    align: center bottom;
    background: transparent;
}

#boot-screen,
#wizard-shell,
#menu-shell {
    background: $background;
}

.wizard-title,
.menu-section-title,
.session-section-title,
#menu-right-title,
#provider-dialog-title,
#search-engine-title,
#search-engine-editor-title,
#search-engine-list > .option-list--option-highlighted,
#search-engine-list:focus > .option-list--option-highlighted,
#search-engine-actions > .option-list--option-highlighted,
#search-engine-actions:focus > .option-list--option-highlighted,
#rename-dialog-title,
#mcp-dialog-title,
#ask-user-title,
#tool-approval-title,
#conversation-search-title,
#delete-session-title,
#pet-dialog-title,
#session-theme-title {
    color: $primary;
}

OptionList > .option-list--option-highlighted,
OptionList:focus > .option-list--option-highlighted {
    color: $primary;
}

#menu-shell,
#wizard-shell,
#session-left,
#session-right,
#session-heading,
#composer,
#prompt-line,
#prompt-input,
#slash-suggestions,
#thinking-status,
#queue-status,
#provider-dialog,
#search-engine-dialog,
#rename-dialog,
#mcp-dialog,
#ask-user-dialog,
#tool-approval-dialog,
#conversation-search-dialog,
#delete-session-dialog,
#provider-dialog-list,
#search-engine-list,
#search-engine-actions,
#menu-model-search,
#ask-user-choices,
#tool-approval-options,
#tool-approval-detail,
#ask-user-input,
#conversation-search-input,
#provider-dialog-input,
#rename-dialog-input,
#mcp-dialog-editor,
#session-theme-dialog,
#session-theme-preview {
    background: $surface;
}

#menu-right-panel,
#session-topbar {
    background: $panel;
}

#wizard-copy,
.wizard-copy,
.session-label,
#menu-runtime-info,
#menu-right-detail,
#project-path,
#session-subtitle,
#shortcut-hint,
#provider-dialog-detail,
#search-engine-detail,
#search-engine-editor-detail,
#rename-dialog-detail,
#mcp-dialog-detail,
#ask-user-hint,
#tool-approval-hint,
#conversation-search-hint,
#delete-session-hint,
#provider-dialog-hint,
#search-engine-hint,
#session-theme-copy,
#session-theme-help {
    color: $text-muted;
}

#menu-secret-input:focus,
#menu-text-input:focus,
#custom-base-url:focus,
#provider-api-key:focus,
#cloudflare-account-id:focus,
#custom-model-name:focus {
    border-bottom: solid $primary;
}

#welcome-prompt {
    border-top: solid $primary;
}

#session-topbar,
#session-heading,
#session-left,
#session-right,
#conversation,
#composer,
#prompt-line,
#prompt-input,
#slash-suggestions,
#thinking-status,
#queue-status,
#provider-dialog,
#rename-dialog,
#mcp-dialog,
#ask-user-dialog,
#tool-approval-dialog,
#conversation-search-dialog,
#delete-session-dialog,
#provider-dialog-list,
#ask-user-choices,
#tool-approval-options,
#tool-approval-detail,
#ask-user-input,
#conversation-search-input,
#provider-dialog-input,
#rename-dialog-input,
#mcp-dialog-editor,
#session-theme-dialog,
#session-theme-preview {
    color: $foreground;
}

#session-heading,
#prompt-line,
#prompt-input,
#slash-suggestions,
#thinking-status,
#queue-status,
#provider-dialog,
#rename-dialog,
#mcp-dialog,
#ask-user-dialog,
#tool-approval-dialog,
#conversation-search-dialog,
#delete-session-dialog,
#provider-dialog-list,
#ask-user-choices,
#tool-approval-options,
#tool-approval-detail,
#ask-user-input,
#conversation-search-input,
#provider-dialog-input,
#rename-dialog-input,
#mcp-dialog-editor,
#session-theme-dialog,
#session-theme-preview {
    background: $surface;
}

#session-theme-dialog {
    width: 66;
    max-width: 88%;
    height: auto;
    max-height: 70%;
    padding: 1 1;
    border: round $primary;
}

#delete-session-dialog {
    border: round $primary;
}

#delete-session-title {
    color: $error;
}

#delete-session-cancel {
    color: $primary;
    border: tall $secondary;
    background: $surface;
}

#delete-session-cancel:focus {
    color: $foreground;
    border: tall $primary;
    background: $boost;
}

#delete-session-confirm {
    color: $error;
    border: tall $error;
    background: $surface;
}

#delete-session-confirm:focus {
    color: $background;
    border: tall $error;
    background: $error;
    text-style: bold;
}

#session-theme-title {
    height: 1;
    margin-bottom: 1;
    text-style: bold;
    text-align: center;
}

#session-theme-copy {
    width: 100%;
    height: auto;
    margin-bottom: 1;
    text-align: center;
}

#session-theme-layout {
    width: 100%;
    height: 8;
}

#session-theme-list {
    width: 29;
    max-height: 8;
}

#session-theme-preview {
    width: 1fr;
    min-width: 24;
    height: 6;
    padding: 0 1;
    border: round $secondary;
    background: $panel;
    content-align: center middle;
}

#session-theme-help {
    height: 1;
    margin-top: 1;
    text-align: center;
}

#session-topbar {
    border-bottom: solid $secondary;
}

#session-left {
    border-right: solid $secondary;
}

#session-right {
    border-left: solid $secondary;
}

#session-heading {
    border-bottom: solid $secondary;
}

#conversation {
    scrollbar-color: $primary;
    scrollbar-color-hover: $accent;
    scrollbar-color-active: $accent;
    scrollbar-background: $background;
    scrollbar-background-hover: $background;
    scrollbar-background-active: $background;
}

.system-message,
.assistant-message {
    border-left: solid $secondary;
    background: $surface;
    color: $foreground;
}

.streaming-message {
    border-left: tall $primary;
    background: $panel;
}

.user-message {
    border-left: solid $accent;
    background: $boost;
    color: $foreground;
}

.tool-message {
    border-left: solid $primary;
    color: $primary;
}

.tool-result-message {
    border-left: solid $secondary;
    color: $text-muted;
}

.search-hit {
    background: $panel;
}

.search-current {
    border-left: tall $accent;
    background: $boost;
    text-style: bold;
}

.success-message {
    color: $success;
}

.error-message {
    color: $error;
}

#conversation-search-input {
    width: 100%;
    height: 3;
    margin-bottom: 1;
    padding: 0 1;
    border: round $secondary;
    background: $surface;
    color: $foreground;
}

#conversation-search-input:focus {
    border: round $primary;
}

#intel-summary,
#target-summary,
#target-list,
#findings-summary,
#exploits-summary,
#ips-summary,
#harvested-summary,
#activity-summary,
#aggressive-level {
    color: $text-muted;
}

#companion-status {
    color: $success;
}

#thinking-status {
    border-left: tall $primary;
}

#slash-suggestions {
    border-left: tall $primary;
}

#prompt-symbol {
    color: $primary;
    background: $surface;
}

#prompt-input {
    border: solid $secondary;
}

#prompt-input:focus {
    border: solid $primary;
    background: $surface;
}

#prompt-input .text-area--cursor {
    color: $text;
    background: transparent;
    text-style: none;
}

#observations-scroll {
    border-left: solid $secondary;
    background: $panel;
    scrollbar-color: $secondary;
    scrollbar-color-hover: $primary;
    scrollbar-color-active: $primary;
}

#observations-summary {
    color: $text-muted;
}

#provider-dialog-input:focus,
#search-engine-base-url:focus,
#search-engine-api-key:focus,
#search-engine-cx:focus,
#search-engine-port:focus,
#rename-dialog-input:focus,
#mcp-dialog-editor:focus,
#ask-user-input:focus,
#conversation-search-input:focus {
    border: round $primary;
}

#session-right:focus,
#conversation:focus {
    scrollbar-color: $accent;
}

#provider-dialog,
#general-config-dialog,
#search-engine-dialog,
#rename-dialog,
#mcp-dialog,
#ask-user-dialog,
#tool-approval-dialog,
#conversation-search-dialog {
    border: round $primary;
}

#provider-dialog-title,
#general-config-title,
#rename-dialog-title,
#mcp-dialog-title,
#ask-user-title,
#tool-approval-title,
#conversation-search-title,
#ask-user-choices > .option-list--option-highlighted,
#ask-user-choices:focus > .option-list--option-highlighted,
#tool-approval-options > .option-list--option-highlighted,
#tool-approval-options:focus > .option-list--option-highlighted,
#provider-dialog-list > .option-list--option-highlighted,
#provider-dialog-list:focus > .option-list--option-highlighted {
    color: $primary;
}

#theme-preview {
    border-left: solid $secondary;
}

#wizard-page-welcome {
    border: round $secondary;
}

#menu-dashboard {
    border-top: solid $secondary;
}

#menu-left-panel {
    border-right: solid $secondary;
}

#menu-left-rule {
    color: $secondary;
}

#menu-right-panel {
    border: round $secondary;
}

#docker-password-card {
    border: round $secondary;
    background: $panel;
}

#search-engine-sudo-password {
    border: round $secondary;
    background: $surface;
    color: $foreground;
}

#search-engine-sudo-password:focus {
    border: round $primary;
}

#menu-model-search {
    border: round $secondary;
    background: $surface;
    color: $foreground;
}

#menu-model-search:focus {
    border: round $primary;
}

#menu-mcp-editor {
    border: round $secondary;
    background: $surface;
    color: $foreground;
}

#menu-mcp-editor:focus {
    border: round $primary;
}

#menu-custom-tool-input {
    border: round $secondary;
    background: $surface;
    color: $foreground;
}

#menu-custom-tool-input:focus {
    border: round $primary;
}

#menu-secret-input,
#menu-text-input,
#custom-base-url,
#provider-api-key,
#cloudflare-account-id,
#custom-model-name {
    color: $foreground;
    border-bottom: solid $secondary;
}

#composer {
    border-top: solid $secondary;
}

#prompt-symbol {
    background: $surface;
}

#prompt-input,
#provider-dialog-input,
#rename-dialog-input,
#menu-mcp-editor,
#mcp-dialog-editor,
#ask-user-input {
    border: round $secondary;
}

#provider-dialog-list,
#ask-user-choices,
#tool-approval-options {
    border: round $secondary;
}

#tool-approval-detail {
    border: round $secondary;
}

#wizard-page-welcome .wizard-title,
#welcome-prompt,
#theme-preview,
#menu-left-rule,
#menu-runtime-info,
#menu-right-detail,
#menu-footer,
#menu-custom-tool-step,
#menu-custom-tool-nav-hint,
#shortcut-hint,
#provider-dialog-hint,
#ask-user-hint,
#tool-approval-hint,
#mcp-dialog-hint {
    color: $text-muted;
}

.menu-section-title,
.session-section-title,
#session-title,
#menu-right-title,
#menu-custom-tool-form-title,
#provider-dialog-title,
#general-config-title,
#rename-dialog-title,
#mcp-dialog-title,
#ask-user-title,
#tool-approval-title {
    color: $primary;
}

.theme-moss #thinking-status,
.theme-lilac #thinking-status,
.theme-ocean #thinking-status,
.theme-rose #thinking-status,
.theme-gold #thinking-status,
.theme-blue #thinking-status,
.theme-moss #prompt-symbol,
.theme-lilac #prompt-symbol,
.theme-ocean #prompt-symbol,
.theme-rose #prompt-symbol,
.theme-gold #prompt-symbol,
.theme-blue #prompt-symbol {
    background: $surface;
    color: $primary;
}

.theme-moss #prompt-input:focus,
.theme-lilac #prompt-input:focus,
.theme-ocean #prompt-input:focus,
.theme-rose #prompt-input:focus,
.theme-gold #prompt-input:focus,
.theme-blue #prompt-input:focus {
    border: round $primary;
    background: $surface;
}

.theme-moss #slash-suggestions,
.theme-lilac #slash-suggestions,
.theme-ocean #slash-suggestions,
.theme-rose #slash-suggestions,
.theme-gold #slash-suggestions,
.theme-blue #slash-suggestions {
    border-left: tall $primary;
    background: $surface;
}

.theme-moss .brand-sparkles,
.theme-lilac .brand-sparkles,
.theme-ocean .brand-sparkles,
.theme-rose .brand-sparkles,
.theme-gold .brand-sparkles,
.theme-blue .brand-sparkles,
.theme-moss .mascot-flourish,
.theme-lilac .mascot-flourish,
.theme-ocean .mascot-flourish,
.theme-rose .mascot-flourish,
.theme-gold .mascot-flourish,
.theme-blue .mascot-flourish,
.theme-moss .wizard-title,
.theme-lilac .wizard-title,
.theme-ocean .wizard-title,
.theme-rose .wizard-title,
.theme-gold .wizard-title,
.theme-blue .wizard-title,
.theme-moss .menu-section-title,
.theme-lilac .menu-section-title,
.theme-ocean .menu-section-title,
.theme-rose .menu-section-title,
.theme-gold .menu-section-title,
.theme-blue .menu-section-title,
.theme-moss .session-section-title,
.theme-lilac .session-section-title,
.theme-ocean .session-section-title,
.theme-rose .session-section-title,
.theme-gold .session-section-title,
.theme-blue .session-section-title {
    color: $primary;
}

.theme-moss OptionList:focus > .option-list--option-highlighted,
.theme-lilac OptionList:focus > .option-list--option-highlighted,
.theme-ocean OptionList:focus > .option-list--option-highlighted,
.theme-rose OptionList:focus > .option-list--option-highlighted,
.theme-gold OptionList:focus > .option-list--option-highlighted,
.theme-blue OptionList:focus > .option-list--option-highlighted {
    color: $primary;
}

/* Chat activity cards use complete panels instead of indented marker rails. */
.tool-message {
    width: 100%;
    height: auto;
    margin: 1 0 0 0;
    padding: 0 1;
    border: round $secondary;
    background: $panel;
    color: $foreground;
}

.tool-result-message {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
    padding: 0 1;
    border: round $secondary;
    background: $surface;
    color: $text-muted;
}

.tool-result-message:hover,
.tool-result-message:focus {
    border: round $primary;
}

#thinking-status,
#queue-status {
    width: 100%;
    height: auto;
    margin: 0 1;
    padding: 0 1;
    border: round $secondary;
    background: $panel;
}

#thinking-status {
    max-height: 3;
    color: $foreground;
}

.theme-moss #thinking-status,
.theme-lilac #thinking-status,
.theme-ocean #thinking-status,
.theme-rose #thinking-status,
.theme-gold #thinking-status,
.theme-blue #thinking-status {
    border: round $secondary;
    background: $panel;
    color: $foreground;
}

#queue-status {
    max-height: 4;
    color: $text-muted;
}

#companion-status.is-notice {
    color: $primary;
}

SudoPasswordDialog {
    align: center bottom;
    background: #000000 26%;
}

#sudo-password-dialog {
    width: 70;
    max-width: 90%;
    height: auto;
    max-height: 16;
    margin-bottom: 3;
    padding: 0 2;
    border: round $primary;
    background: $surface;
}

#sudo-password-title {
    height: 1;
    margin-bottom: 0;
    color: $primary;
    text-style: bold;
    text-align: center;
}

#sudo-password-message,
#sudo-password-command,
#sudo-password-note {
    width: 100%;
    height: auto;
    margin: 0;
}

#sudo-password-message {
    color: $foreground;
}

#sudo-password-command {
    max-height: 2;
    margin-top: 0;
    padding: 0 1;
    background: $panel;
    color: $primary;
}

#sudo-password-note {
    height: 1;
    margin-top: 0;
    color: $text-muted;
}

#sudo-password-input {
    height: 3;
    margin: 0;
    border: round $secondary;
    background: $panel;
    color: $foreground;
}

#sudo-password-input:focus {
    border: round $primary;
}

#sudo-password-actions {
    height: 3;
    margin-top: 0;
    align-horizontal: right;
}

#sudo-password-hint {
    height: 1;
    margin-top: 0;
    color: $text-muted;
    text-align: center;
}

#slash-suggestions {
    width: 100%;
    height: auto;
    max-height: 9;
    margin: 0;
    padding: 0 1;
    border: round $secondary;
    background: $surface;
}

.theme-moss #slash-suggestions,
.theme-lilac #slash-suggestions,
.theme-ocean #slash-suggestions,
.theme-rose #slash-suggestions,
.theme-gold #slash-suggestions,
.theme-blue #slash-suggestions {
    border: round $secondary;
    background: $surface;
}

#rename-dialog {
    width: 62;
    max-width: 88%;
    height: auto;
    max-height: 12;
    padding: 1 2;
}

#rename-dialog-detail {
    height: 1;
    min-height: 1;
}

#rename-dialog-input {
    margin-top: 1;
}

SessionExportDialog,
SessionExportOverwriteDialog {
    align: center middle;
    background: #000000 38%;
}

#export-dialog {
    width: 88;
    max-width: 92%;
    height: auto;
    max-height: 14;
    padding: 1 2;
    border: round $primary;
    background: $surface;
}

#export-dialog-title {
    height: 1;
    margin-bottom: 1;
    color: $primary;
    text-style: bold;
    text-align: center;
}

#export-dialog-detail {
    width: 100%;
    height: auto;
    max-height: 3;
    margin-bottom: 1;
    color: $text-muted;
    text-align: center;
}

#export-dialog-input {
    width: 100%;
    height: 3;
    padding: 0 1;
    border: round $secondary;
    background: $panel;
    color: $foreground;
}

#export-dialog-input:focus {
    border: round $primary;
}

#export-overwrite-actions {
    width: 100%;
    height: 3;
    margin: 1 0;
    align: center middle;
}

#export-overwrite-actions Button {
    margin: 0 1;
}

#export-dialog-hint {
    height: 1;
    color: $text-muted;
    text-align: center;
}
OperatorDialog {
    align: center bottom;
    background: #000000 18%;
}

#operator-dialog {
    width: 70;
    max-width: 90%;
    height: auto;
    max-height: 22;
    margin-bottom: 3;
    padding: 0 2;
    border: round $primary;
    background: $surface;
}

#operator-dialog-title {
    margin-bottom: 0;
}

#operator-dialog-question {
    margin: 0 0 1 0;
}

#operator-dialog-options {
    max-height: 8;
    margin: 0;
}

#operator-dialog-input {
    margin: 0;
}

#operator-dialog-actions {
    height: 3;
    margin-top: 0;
}

#operator-dialog-hint {
    height: 1;
    margin-top: 0;
}
